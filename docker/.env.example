# TrendRadarht - example only. DO NOT put real secrets in Git.
# Copy to docker/.env only for local use. docker/.env is ignored by Git.

# Web: safest default = localhost only.
# For LAN access, set this to the Ubuntu LAN IP (recommended) instead of 0.0.0.0.
WEBSERVER_HOST=127.0.0.1
WEBSERVER_PORT=8080

# Telegram
# Easy Portainer method: set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in Stack Environment variables.
# Stronger method: mount a chmod 600 token file and set TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID=

# Other notifications
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
WEWORK_WEBHOOK_URL=
WEWORK_MSG_TYPE=
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_PASSWORD_FILE=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=
NTFY_SERVER_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_TOKEN_FILE=
BARK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_TEMPLATE=

# Local AI
AI_ANALYSIS_ENABLED=true
AI_API_KEY=ollama
AI_API_KEY_FILE=
AI_MODEL=ollama/qwen2.5:3b
AI_API_BASE=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional S3
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY=
S3_SECRET_ACCESS_KEY_FILE=
S3_REGION=

# Runtime
CRON_SCHEDULE=*/30 * * * *
RUN_MODE=cron
IMMEDIATE_RUN=true
